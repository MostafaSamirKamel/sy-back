# Server
PORT=5000
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-secret-key
JWT_EXPIRES_IN=365d
CLIENT_URL=http://localhost:5173

# Database — SQLite (default) OR MySQL
DATABASE_URL="file:./dev.db"
# DATABASE_URL="mysql://your-db-user:your-db-password@localhost:3306/your-db-name"

# AI Provider (openai | gemini | mock)
AI_PROVIDER=openai
# Optional OpenRouter (also configurable in Admin → Settings)
# OPENROUTER_API_KEY=your-openrouter-api-key
# OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-5-mini
# Speech-to-text: openai (recommended) | local (on-server Whisper; needs working ffmpeg)
# On Windows, prefer openai — bundled ffmpeg-static often fails with spawn EFTYPE.
STT_PROVIDER=openai
# LOCAL_WHISPER_MODEL=Xenova/whisper-small
# Optional: path to a working ffmpeg binary if using STT_PROVIDER=local
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
OPENAI_WHISPER_MODEL=gpt-4o-transcribe
# Optional OpenAI Realtime WebRTC voice-call overrides (use only voices supported by your model).
# OPENAI_REALTIME_MODEL=gpt-realtime-mini
# OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-4o-transcribe
# OPENAI_REALTIME_VOICE=alloy
# OPENAI_REALTIME_VOICE_MALE=
# OPENAI_REALTIME_VOICE_FEMALE=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE_AR=nova
# OPENAI_TTS_VOICE_EN=alloy
# Experimental request/response audio comparison (keeps OpenAI Realtime intact).
# VOICE_PROVIDER=openrouter_audio
# OPENROUTER_TTS_MODEL=x-ai/grok-voice-tts-1.0
# OPENROUTER_TTS_VOICE=ara
# OPENROUTER_TTS_VOICE_MALE=rex
# OPENROUTER_TTS_VOICE_FEMALE=ara
# Defaults to openai/whisper-large-v3-turbo, which accepts Chrome WebM/Opus recordings.
# OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3-turbo
GEMINI_API_KEY=

# Admin seed credentials
ADMIN_EMAIL=admin@synoza.com
ADMIN_PASSWORD=your-local-admin-password

# SMTP (email verification OTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=your-smtp-from@example.com
SMTP_FROM_NAME=Synoza

# Payment gateway (Paymob Accept — Egypt)
# Default: paymob (add keys below). Use mock for local testing without keys.
PAYMENT_PROVIDER=paymob
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_CURRENCY=EGP
# Public URL Paymob redirects to after payment (production API URL)
PAYMENT_CALLBACK_BASE_URL=

# Payment gateway (Kashier / كاشير — Egypt)
# Set PAYMENT_PROVIDER=kashier to use Kashier instead of Paymob.
# KASHIER_MODE: live (real payments) or test (test-api.kashier.io).
KASHIER_MID=MID-XXXXX-XXX
KASHIER_API_KEY=
KASHIER_SECRET_KEY=
KASHIER_MODE=live
KASHIER_CURRENCY=EGP
KASHIER_ALLOWED_METHODS=card,wallet,bank_installments
