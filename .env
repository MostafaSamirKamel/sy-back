# Server
PORT=5000
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-secret-key-1234567890
JWT_EXPIRES_IN=365d
CLIENT_URL=http://localhost:5173

# Database — SQLite (default) OR MySQL
DATABASE_URL="file:./dev.db"

# AI Provider (openai | gemini | mock | openrouter)
AI_PROVIDER=openrouter
# OpenRouter
OPENROUTER_API_KEY=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
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=openai/gpt-4o
OPENAI_PATIENT_MODEL=openai/gpt-4o
# Speech-to-text: openai (recommended) | local (on-server Whisper; needs working ffmpeg)
# On Windows, prefer openai — bundled ffmpeg-static often fails with spawn EFTYPE.
STT_PROVIDER=openai
# LOCAL_WHISPER_MODEL=Xenova/whisper-small
# Optional: path to a working ffmpeg binary if using STT_PROVIDER=local
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
OPENAI_WHISPER_MODEL=gpt-4o-transcribe

# Admin seed credentials
ADMIN_EMAIL=admin@synoza.com
ADMIN_PASSWORD=Admin@123456

# SMTP (email verification OTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=your-smtp-from@example.com
SMTP_FROM_NAME=Synoza

# Payment gateway (Paymob Accept — Egypt)
# Default: paymob (add keys below). Use mock for local testing without keys.
PAYMENT_PROVIDER=mock
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_CURRENCY=EGP
# Public URL Paymob redirects to after payment (production API URL)
PAYMENT_CALLBACK_BASE_URL=

# Payment gateway (Kashier / كاشير — Egypt)
# Set PAYMENT_PROVIDER=kashier to use Kashier instead of Paymob.
# KASHIER_MODE: live (real payments) or test (test-api.kashier.io).
KASHIER_MID=MID-XXXXX-XXX
KASHIER_API_KEY=
KASHIER_SECRET_KEY=
KASHIER_MODE=live
KASHIER_CURRENCY=EGP
KASHIER_ALLOWED_METHODS=card,wallet,bank_installments
